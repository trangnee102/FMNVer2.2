// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================
// ENUMS CHO HỆ THỐNG THI TRẮC NGHIỆM
// =========================================
enum QuestionType {
  FLASHCARD       
  TRUE_FALSE      
  SINGLE_CHOICE   
  MULTIPLE_CHOICE 
  FILL_BLANK      
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionCategory {
  THEORY    
  PRACTICE  
}

model Decks {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  is_public    Boolean?     @default(false)
  is_anonymous Boolean?     @default(false)
  clone_count  Int?         @default(0)
  category     String?
  
  is_exam      Boolean?     @default(false)

  user_id      Int
  Users        Users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Flashcards   Flashcards[]
  StudyLogs    StudyLogs[]
  
  QuickTestRooms QuickTestRoom[]
}

model Flashcards {
  id              Int               @id @default(autoincrement())
  deck_id         Int
  question        String
  answer          String
  
  question_type   QuestionType?     @default(FLASHCARD)
  difficulty      Difficulty?       @default(MEDIUM)
  category        QuestionCategory? @default(THEORY)
  
  options         String?            
  correct_answers String?            

  source_reference String?          
  keywords         String?          
  explanation      String?          

  Decks            Decks            @relation(fields: [deck_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  StudyProgress    StudyProgress[]
  StudyLogs        StudyLogs[]
  
  QuickTestAnswers QuickTestAnswer[]
}

model StudyProgress {
  id               Int        @id @default(autoincrement())
  flashcard_id     Int
  user_id          Int
  ease_factor      Float?     @default(2.5)
  interval         Int?       @default(0)
  repetitions      Int?       @default(0)
  next_review_date DateTime?  @default(now())
  Flashcards       Flashcards @relation(fields: [flashcard_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Users            Users      @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model StudyLogs {
  id           Int        @id @default(autoincrement())
  user_id      Int
  flashcard_id Int
  deck_id      Int
  rating       Int
  duration_ms  Int?       @default(0)
  is_exam_mode Boolean?   @default(false)
  reviewed_at  DateTime   @default(now())
  Users        Users      @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  Flashcards   Flashcards @relation(fields: [flashcard_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Decks        Decks      @relation(fields: [deck_id], references: [id], onUpdate: NoAction)

  @@index([user_id, deck_id, is_exam_mode])
}

// =========================================
// HỆ SINH THÁI CHAT CHUẨN ZALO
// =========================================
model Conversations {
  id          Int      @id @default(autoincrement())
  name        String?  
  is_group    Boolean  @default(false)  
  invite_code String?  @unique 
  created_at  DateTime @default(now())

  Messages     Messages[]
  Participants Participants[]
}

model Participants {
  id                   Int      @id @default(autoincrement())
  conversation_id      Int
  user_id              Int
  role                 String   @default("member") 
  joined_at            DateTime @default(now())
  last_read_message_id Int?     @default(0)

  Conversation  Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User          Users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([conversation_id, user_id])
}

model Messages {
  id              Int      @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  content         String?  
  message_type    String?  @default("text") 
  file_url        String?  
  file_name       String?  
  created_at      DateTime @default(now())

  Conversation  Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Sender        Users         @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Friendships {
  id           Int      @id @default(autoincrement())
  requester_id Int      
  addressee_id Int      
  status       String   @default("pending") 
  created_at   DateTime @default(now()) 

  Requester    Users    @relation("SentRequests", fields: [requester_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Addressee    Users    @relation("ReceivedRequests", fields: [addressee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([requester_id, addressee_id])
}

model Users {
  id            Int             @id @default(autoincrement())
  email         String          @unique 
  password_hash String          
  role          String?         @default("student") 
  
  full_name     String?         
  avatar_text   String?         
  avatar_color  String?         
  streak_days   Int?            @default(0)
  total_cards   Int?            @default(0)
  total_points  Int?            @default(0)
  is_online     Boolean?        @default(false)

  created_at             DateTime? @default(now())
  community_notification Boolean?  @default(true)
  due_notification       Boolean?  @default(true)
  study_reminder         Boolean?  @default(true)

  Decks         Decks[]
  StudyProgress StudyProgress[]
  StudyLogs     StudyLogs[]     
  
  Participations         Participants[]
  MessagesSent           Messages[]
  FriendRequestsSent     Friendships[]   @relation("SentRequests")
  FriendRequestsReceived Friendships[]   @relation("ReceivedRequests")

  QuickTestRoomsCreated  QuickTestRoom[]        @relation("TeacherRooms")
  QuickTestJoined        QuickTestParticipant[] @relation("UserParticipations")
}

// ==========================================
// MODULE: QUICKTEST (REAL-TIME QUIZ)
// ==========================================

model QuickTestRoom {
  id          String    @id @default(uuid()) 
  teacherId   Int?      // 👉 ĐÃ FIX: Cho phép null tạm thời để ko xung đột dữ liệu cũ
  examId      Int?      // 👉 ĐÃ FIX: Cho phép null
  roomCode    String    @unique 
  title       String?   // 👉 ĐÃ FIX: Cho phép null
  status      String    @default("WAITING") 
  startTime   DateTime? 
  endTime     DateTime? 
  duration    Int?      // 👉 ĐÃ FIX: Cho phép null
  createdAt   DateTime  @default(now())

  // Quan hệ
  Teacher      Users?                 @relation("TeacherRooms", fields: [teacherId], references: [id], onDelete: Cascade)
  Exam         Decks?                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  Participants QuickTestParticipant[]
}

model QuickTestParticipant {
  id                String    @id @default(uuid())
  roomId            String
  userId            Int?      
  studentName       String?   // 👉 ĐÃ FIX: Cho phép null
  score             Int       @default(0) 
  correctCount      Int       @default(0) 
  wrongCount        Int       @default(0) 
  averageAnswerTime Float     @default(0) 
  rank              Int?      

  // Quan hệ
  User              Users?            @relation("UserParticipations", fields: [userId], references: [id], onDelete: SetNull)
  Room              QuickTestRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  Answers           QuickTestAnswer[]
}

model QuickTestAnswer {
  id             String    @id @default(uuid())
  participantId  String
  questionId     Int       
  selectedAnswer String?   // 👉 ĐÃ FIX: Cho phép null
  isCorrect      Boolean   
  answerTime     Int       

  // Quan hệ
  Participant    QuickTestParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  Question       Flashcards           @relation(fields: [questionId], references: [id], onDelete: Cascade)
}